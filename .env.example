POSTGRES_USER=dreamabroad
POSTGRES_PASSWORD=dreamabroad
POSTGRES_DB=dreamabroad
DATABASE_URL=postgresql://dreamabroad:dreamabroad@db:5432/dreamabroad
API_PORT=3000
WEB_PORT=5173

# LINE Messaging API — get these from https://developers.line.biz
# Leave as "mock-*" to run without real LINE integration
LINE_CHANNEL_SECRET=mock-secret
LINE_CHANNEL_ACCESS_TOKEN=mock-token

# ngrok — get from https://dashboard.ngrok.com/get-started/your-authtoken
# Required only when running `docker compose --profile tunnel up`
NGROK_AUTHTOKEN=

# Auto-archive thresholds (days)
# Enrolled customers older than this get moved to "closed" (no auto-revive)
ENROLLED_ARCHIVE_DAYS=90
# Lead customers with no activity for this many days get moved to "archived"
# (will auto-revive to Lead if they message again)
LEAD_COLD_DAYS=90
