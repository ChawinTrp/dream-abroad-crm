# Production image — multi-stage to keep final size small.
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY prisma ./prisma
RUN npx prisma generate
COPY . .
RUN npm run build
# Compile the seed (prisma/seed.ts) to plain JS so the runtime stage can run
# it with `node` — no ts-node needed in production. Output: dist-seed/seed.js
RUN npx tsc prisma/seed.ts --outDir dist-seed --module commonjs \
    --esModuleInterop --skipLibCheck --target ES2021 --moduleResolution node

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/dist-seed ./dist-seed
COPY --from=builder /app/prisma ./prisma
EXPOSE 3000
# Boot sequence:
#   1. prisma db push  — sync schema (npx auto-fetches the prisma CLI)
#   2. node dist-seed/seed.js — bootstrap REFERENCE data only (stages, tags,
#      agents). Idempotent (upserts). Skips demo customers unless SEED_DEMO=true.
#      Real customers arrive via the LINE webhook, never seeded.
#   3. node dist/src/main — start the API
CMD ["sh", "-c", "npx prisma db push --accept-data-loss && node dist-seed/seed.js && node dist/src/main"]
